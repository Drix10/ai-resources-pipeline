# Dependencies
node_modules/

# Secrets: every .env variant holds keys; only the template is versioned
.env
.env.*
!.env.example

# Local config with personal data (copy config/creators.example.json)
config/creators.json

# Next.js builds and deploy metadata
blog/.next/
blog/out/
blog/.turbo/
portfolio/.next/
portfolio/out/
portfolio/.turbo/
.next/
.vercel/

# Logs and failure screenshots (written to logs/ and the repo root)
*.log
logs/
*.png
!blog/public/**/*.png
!portfolio/public/**/*.png

# Runtime state and locks (machine-local)
.pipeline.lock
.pipeline.lock.*
.pipeline-state.json*
.processed-tweet-ids.json*
data/*.json
data/*.json.*
data/*.jsonl
data/*.tmp*
data/*.lock
blog/lib/views-data.json*
*.tmp
*.lock
!package-lock.json
!blog/package-lock.json
!portfolio/package-lock.json

# Temporary files and previews
temp/
linkedin-previews/

# Local tools kept out of the repository
tracker/

# The content factory: an optional add-on in its own private repository, checked out here
/factory/

# Editors, OS and tooling
.vscode/
.idea/
.claude/
.gemini/
.DS_Store
Thumbs.db
coverage/
*.tsbuildinfo
