# Dependencies
/node_modules
/blog/node_modules
/portfolio/node_modules
/factory/node_modules

# Environment variables
.env
.env.local
.env.*.local

# Next.js build output & caches
blog/.next/
blog/out/
blog/.turbo/
portfolio/.next/
portfolio/out/
portfolio/.turbo/
.next/

# Logs
helpers.log
error.log
*.log

# VSCode & IDEs
.vscode/
.idea/
.gemini/

# Chrome user data (session persistence)
chrome-data/

# Temporary slide/upload files generated at runtime
/temp/
/temp/**
linkedin-previews/
scratch/

# Debug dump files (generated by diagnostic scripts)
body-dump.html
iframe-dump.html
button-dump.txt

# Failure/debug screenshots saved to project root
*.png
!public/**/*.png
!assets/**/*.png
!blog/public/**/*.png
!portfolio/public/**/*.png

# LinkedIn & Twitter debug screenshots
linkedin-post-failed.png
linkedin-search-failed.png
tweet-failed.png
login-error.png

# Runtime coordination locks & temporary cache
.pipeline.lock
.pipeline-state.json
.pipeline-state.json.tmp
.processed-tweet-ids.json
.processed-tweet-ids.json.tmp
.processed-tweet-ids.json.bak
.processed-tweet-ids.json.corrupt-*
tracker/

# Dynamic View Counter Data (Persists per-deployment)
blog/lib/views-data.json
blog/lib/views-data.json.tmp
views-data.json
*.tmp
*.lock
data/*.tmp*
data/*.lock

# Runtime state (machine-local trackers)
data/linkedin-feed-commented.json
data/linkedin-feed-commented.json.*
data/syndication-queue.json
data/syndication-queue.json.*

# TypeScript incremental build caches
*.tsbuildinfo

# Personal list of LinkedIn creators to engage with (copy config/creators.example.json)
config/creators.json

# Instagram content factory: renders, agent workspaces, ledger
factory/state/
factory/out/
# Reference library: cloned repos (npm run factory:library) and downloaded videos
factory/library/repos/
factory/library/videos/*/video.mp4
# Music: the tracks stay on this machine (commercial recordings, never published); the folder
# layout and catalog.json (tempo, drops, energy, vocals) are versioned.
factory/library/music/*/*
!factory/library/music/*/.gitkeep
# Stock clips: licences forbid redistributing them as-is; meta.json + contact.jpg are versioned.
factory/library/visuals/*/clip.mp4
factory/library/visuals/*/clip.*.tmp
