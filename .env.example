# ==============================================================================
# AI Resources Pipeline: environment template
# Copy to .env and fill in. Lines starting with # show optional settings and their defaults.
# ==============================================================================

# --- GitHub: the repository the articles are committed to (required) ---
GITHUB_PAT=your_github_personal_access_token
GITHUB_USERNAME=your_github_username
GITHUB_REPONAME=your_resources_repo
# A run commits to its day's branch (run/YYYY-MM-DD), merged into main by a pull request at the end (false: main).
GITHUB_RUN_BRANCHES=true
# Co-author on every commit of a run ("Name <email>" of a GitHub account; empty = none).
#GITHUB_CO_AUTHOR=Your Org <support@example.com>

# --- Blog & syndication ---
# Public address of your blog (no trailing slash). Empty: articles get no blog link and nothing is queued for DEV.to.
CANONICAL_BASE_URL=
# DEV.to cross-posting: an article is posted once its blog page is live.
DEVTO_API_KEY=
# true = publish on DEV.to; false = create drafts.
DEVTO_AUTO_PUBLISH=false
# The only branch the blog sync commits to and pushes.
#BLOG_DEPLOY_BRANCH=main

# --- Identity: who the pipeline publishes as (all optional; an empty value leaves its line out) ---
# Your name: article footer, blog byline and the persona LinkedIn replies are written as.
AUTHOR_NAME=
# Your handle, shown as "Name (handle)"; also the author name on commits to the resources repo.
AUTHOR_HANDLE=
# Email for the footer link and commit authorship (empty: commits are attributed to the token's account).
AUTHOR_EMAIL=
# One clause after "Written by <name>, " in the article footer, e.g. "an engineer working on AI systems".
AUTHOR_BIO=
# Footer links (full URLs). The website is also where your name links to.
AUTHOR_WEBSITE_URL=
AUTHOR_GITHUB_URL=
AUTHOR_LINKEDIN_URL=
AUTHOR_X_URL=

# --- LLM engine ---
# Who writes, per job:
#   openrouter = OpenRouter, with NVIDIA NIM as the fallback (an OPENROUTER_API_KEY; pay per token)
#   nvidia     = NVIDIA NIM only (an NVIDIA_API_KEY)
#   local      = Ollama on this machine only (no key)
#   claude     = the claude CLI on your Claude subscription (install: npm i -g @anthropic-ai/claude-code,
#                then run `claude` once to sign in; on a headless machine, `claude setup-token` and
#                CLAUDE_CODE_OAUTH_TOKEN in the environment). It runs with your own Claude Code setup
#                (CLAUDE.md, hooks, plugins) switched off. If a call fails there (usage limit, signed
#                out), the OpenRouter/NVIDIA chain takes over when it has a key.
# LLM_PROVIDER sets every job; the three below override it for one job each.
LLM_PROVIDER=openrouter
# Articles.
#LLM_ARTICLE_PROVIDER=
# LinkedIn comments and their critic.
#LLM_COMMENT_PROVIDER=
# The LinkedIn viral pass (default: the comment provider). With claude it also sees a screenshot of the post.
#LLM_VIRAL_PROVIDER=

# Claude (a provider set to claude)
#CLAUDE_BIN=claude
#CLAUDE_MODEL=claude-sonnet-5-5
# --effort: low | medium | high | xhigh | max
#CLAUDE_EFFORT=medium
#CLAUDE_VIRAL_MODEL=claude-opus-5-5
#CLAUDE_VIRAL_EFFORT=high
#CLAUDE_REQUEST_TIMEOUT_MS=300000

# Local Ollama (a provider set to local)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma4:latest
LOCAL_LLM_REQUEST_TIMEOUT_MS=300000
# Model for comments and critics (default: LOCAL_LLM_MODEL).
#LOCAL_LLM_COMMENT_MODEL=
# Start "<LOCAL_LLM_COMMAND> serve" when a local Ollama is offline (false = never start it).
#LOCAL_LLM_AUTO_START=true
#LOCAL_LLM_COMMAND=ollama
# How long to wait for a started Ollama to answer.
#LOCAL_LLM_STARTUP_TIMEOUT_MS=60000

# NVIDIA NIM (provider nvidia; also the fallback when OpenRouter fails or has no key)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Cheaper model for comments and critics; set it empty to reuse NVIDIA_MODEL.
#NVIDIA_COMMENT_MODEL=openai/gpt-oss-20b
#NVIDIA_REQUEST_TIMEOUT_MS=240000

# OpenRouter (provider openrouter): articles, LinkedIn comments and critic verdicts (key: openrouter.ai/settings/keys).
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_REQUEST_TIMEOUT_MS=120000
# Comments and critics use deepseek/deepseek-v4-flash; an exact slug from openrouter.ai/models replaces it.
#OPENROUTER_MODEL_OVERRIDE=deepseek/deepseek-v4-flash
# Article writer (benchmarked default) and its fallback.
#OPENROUTER_ARTICLE_MODEL=openai/gpt-oss-120b
#OPENROUTER_ARTICLE_FALLBACK_MODEL=qwen/qwen3.7-flash
# The LinkedIn viral pass (default: the comment model above).
#OPENROUTER_VIRAL_MODEL=
# Run-cost logs for an overridden model the built-in price table does not know: "input,output" USD per 1M tokens.
#OPENROUTER_PRICE_PER_M=0.30,1.00

# --- Articles ---
# Lowest writer-rated information value (1-5) that gets published.
#ARTICLE_MIN_VALUE=3
# false = write from the post alone, without reading the pages it links to or resolving its t.co links
# (the resources then list them as t.co).
#ARTICLE_FETCH_LINKS=true

# --- LinkedIn (browser automation on the Chrome at :9222; log in there once) ---
# Post feed comments (off by default; check the drafts first with `npm run preview`).
LINKEDIN_FEED_REPLY=false
#LINKEDIN_COMMENTS_MAX_PER_DAY=20
# Extra comments on posts going viral (big names in config/viral.js, the day's most-engaged
# launches and funding news), on their own daily cap. Posts only with LINKEDIN_FEED_REPLY=true.
LINKEDIN_VIRAL=true
#LINKEDIN_VIRAL_MAX_PER_DAY=8
# A few likes after each article.
LINKEDIN_LIKE=true
#LINKEDIN_LIKES_MAX_PER_DAY=60
# true = target AI/finance: people who engaged with you, config/creators.json, content and people search, big names,
# topic and US filters. false = the home feed (Top and Recent) for likes and comments (viral too), any topic,
# and "People you may know" for connects.
LINKEDIN_TARGETED=true
# A few no-note connection requests after each batch commit, within rolling caps.
LINKEDIN_CONNECT=true
#LINKEDIN_CONNECT_MAX_PER_DAY=15
#LINKEDIN_CONNECT_MAX_PER_WEEK=90
# Reply to the comments on your own posts (start of each run and after each batch); never twice, never where you replied.
LINKEDIN_OWN_REPLIES=true
#LINKEDIN_OWN_REPLIES_MAX_PER_DAY=30
# Your profile slug (linkedin.com/in/<slug>): spots your own posts and earlier comments.
#LINKEDIN_PROFILE_SLUG=your-slug
# Each LinkedIn pass is stopped after this long (its browser released).
#LINKEDIN_PASS_TIMEOUT_MS=900000
# true = wait up to 5 min for a manual login instead of skipping LinkedIn (scripts/feed-preview.js --wait-login sets it).
#LINKEDIN_INTERACTIVE_LOGIN=false

# --- X / Twitter ---
# Skip X posts older than this many days.
#TWEET_MAX_AGE_DAYS=14
# Reply under other people's X posts after each batch commit: 2 or 3 on fresh posts with real momentum
# (home timeline For you + Following, and a curated list), then 1 or 2 on posts going viral.
X_REPLIES=true
# Rolling 24 h caps: regular replies, and viral ones on top of them.
#X_REPLIES_MAX_PER_DAY=20
#X_REPLIES_VIRAL_MAX_PER_DAY=8
# Each X reply pass is stopped after this long (the viral pass gets twice it).
#X_PASS_TIMEOUT_MS=900000

# --- Reddit ---
# Comment in Reddit threads after each batch commit, from the account logged in to the debug Chrome (subs in
# config/reddit.js): at most 1 a pass, 20-40 min apart, 1 per sub a day, never a product mention. Pain points
# the threads state go to data/reddit-painpoints.jsonl. Reddit refusing pauses the comments 24-48 h.
REDDIT_COMMENTS=true
# Rolling 24 h cap.
#REDDIT_COMMENTS_MAX_PER_DAY=6
# Each Reddit pass is stopped after this long.
#REDDIT_PASS_TIMEOUT_MS=900000

# --- Hugging Face dataset ---
# The resources repo as a dataset on Hugging Face (one Parquet file and a card linking back to GitHub), refreshed
# at the end of a run when the last upload is 7+ days old. A write token from huggingface.co/settings/tokens;
# without it the step is skipped. false = never.
HF_DATASET=true
HF_TOKEN=
# The dataset repository, created on the first upload (default: Drix10/ai-resources).
#HF_DATASET_REPO=Drix10/ai-resources

# --- Running ---
# `npm start` does one full run right away (articles, batch commits, LinkedIn, blog push) and exits.
# There is no scheduler: start it again for the next run.
# production = info-level logs; anything else logs at debug level.
#NODE_ENV=production

# --- Content factory (optional add-on, its own repository with its own .env.example) ---
# true = each run ends with one factory cycle, when the factory is checked out.
FACTORY_ENABLED=false
# Where the factory checkout lives, relative to the repo root.
#FACTORY_DIR=factory
# The factory reads its own factory/.env, or this file when it has none: its names (factory/.env.example)
# can then live here, and OPENROUTER_API_KEY above also serves its narration.

# --- Advanced / tests: state-file overrides (tests/_env.js points them at temp folders) ---
# The run lock (default: .pipeline.lock in the repo root). The factory shares it (both drive one Chrome)
# and resolves a relative path from its own folder, so an override is an absolute path.
#PIPELINE_LOCK_PATH=.pipeline.lock
#PROCESSED_IDS_PATH=.processed-tweet-ids.json
#SYNDICATION_QUEUE_PATH=data/syndication-queue.json
#HF_DATASET_STATE_PATH=data/hf-dataset.json
#LINKEDIN_TRACK_PATH=data/linkedin-feed-commented.json
#BLOG_DIR=blog
#BLOG_REPO_DIR=.
# Base delay between a folder's retry attempts.
#PIPELINE_RETRY_DELAY_MS=5000
