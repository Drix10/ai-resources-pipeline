################################################################################
# ⚠️  SECURITY WARNING - READ BEFORE USING
################################################################################
# 
# 1. NEVER commit your real .env file to version control (Git)
# 2. Ensure .env is listed in .gitignore
# 3. Restrict file permissions: chmod 600 .env (Unix/Mac) or set read-only (Windows)
# 4. If credentials are exposed, IMMEDIATELY rotate them:
#    - GITHUB_PAT: Revoke and create new token at github.com/settings/tokens
#    - TWITTER_PASSWORD: Change at twitter.com/settings/password
#    - DISCORD_WEBHOOK_URL: Delete and recreate webhook in Discord server settings
# 5. Never share this file or credentials in screenshots, logs, or support requests
#
################################################################################

# Required for main app (npm run start)
GITHUB_PAT= # The GitHub personal access token (SENSITIVE - never commit!)
GITHUB_USERNAME= # Your Github Username
GITHUB_REPONAME= # Your Github Repository name

# Local LLM generation
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma4:latest
LOCAL_LLM_REQUEST_TIMEOUT_MS=300000
# Starts `ollama serve` automatically only when the configured URL is local.
LOCAL_LLM_AUTO_START=true
LOCAL_LLM_COMMAND=ollama
LOCAL_LLM_STARTUP_TIMEOUT_MS=60000
MAX_FOLDERS_PER_RUN=12

# LinkedIn publishing (disabled by default). Set to true to generate and publish a curated LinkedIn post.
LINKEDIN_POST=false

# Required for list tracker (npm run list)
DISCORD_WEBHOOK_URL= # Your Discord webhook URL (SENSITIVE - never commit! e.g., https://discord.com/api/webhooks/...)
MONITOR_LIST_ID= # Twitter list ID to track (e.g., 1805784149468340566)

# Optional list tracker settings
CHECK_INTERVAL=300000 # Check interval in milliseconds (default: 5 minutes / 300000ms)
SEND_ALL_TWEETS=false # Set to true to send all tweets, false to filter by keywords
MONITOR_KEYWORDS= # Comma-separated keywords to monitor (e.g., "AI,machine learning,GPT")
