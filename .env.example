# ==============================================================================
# AI Resources Pipeline & Knowledge Hub Environment Template
# ==============================================================================

# --- GitHub Knowledge Sync ---
GITHUB_PAT=your_github_personal_access_token
GITHUB_USERNAME=Drix10
GITHUB_REPONAME=ai-resources

# --- Canonical SEO & Syndication ---
CANONICAL_BASE_URL=https://blogs.drix10.com

# DEV.to Multi-Platform Automated Syndication
DEVTO_API_KEY=your_devto_api_key_here
DEVTO_AUTO_PUBLISH=false

# --- AI LLM Engine Configuration ---
# Set LOCAL_LLM=true for local Ollama, or LOCAL_LLM=false for NVIDIA NIM Cloud API
LOCAL_LLM=false

# Local Ollama Settings (used when LOCAL_LLM=true)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=gemma4:latest
LOCAL_LLM_REQUEST_TIMEOUT_MS=300000

# NVIDIA NIM Cloud API Settings (used when LOCAL_LLM=false)
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter: writes articles, LinkedIn feed comments and critic verdicts.
# Comments and critics use deepseek/deepseek-v4-flash. Set OPENROUTER_MODEL_OVERRIDE (an exact slug
# from openrouter.ai/models) to use a different model; the old OPENROUTER_MODEL is no longer read.
# If OpenRouter fails or no key is set, the NVIDIA/Ollama model takes over for comments.
# Key: openrouter.ai/settings/keys
OPENROUTER_API_KEY=
#OPENROUTER_MODEL_OVERRIDE=deepseek/deepseek-v4-flash
# Article writer (benchmarked default shown) and its fallback; ARTICLE_MIN_VALUE (1-5) is the lowest
# writer-rated information value that gets published.
#OPENROUTER_ARTICLE_MODEL=openai/gpt-oss-120b
#OPENROUTER_ARTICLE_FALLBACK_MODEL=qwen/qwen3.7-flash
#ARTICLE_MIN_VALUE=3
# Optional, for run-cost logs of an overridden model the built-in price table does not know:
# "input,output" USD per 1M tokens. Ignored for the default model.
#OPENROUTER_PRICE_PER_M=0.30,1.00

# --- Social Automation & Alerts ---
LINKEDIN_FEED_REPLY=false
LINKEDIN_LIKE=true
LINKEDIN_SIMPLE_REPLY=false
# targeted = finance/AI/founder content search + config/creators.json (home-feed fallback); feed = home feed only.
LINKEDIN_SOURCE=targeted
# A few no-note connection requests per batch, within rolling caps. On unless set to false.
LINKEDIN_CONNECT=true
#LINKEDIN_CONNECT_MAX_PER_DAY=12
#LINKEDIN_CONNECT_MAX_PER_WEEK=60
# Your profile slug (linkedin.com/in/<slug>): lets a comment pass see you already commented on a post.
#LINKEDIN_PROFILE_SLUG=your-slug
# Each LinkedIn pass is stopped after this long (its browser released).
#LINKEDIN_PASS_TIMEOUT_MS=900000
TWITTER_POST=true
# Announcement tweets per run (at least 20 min apart; the first failure stops them for the run).
#TWITTER_POSTS_PER_RUN=3
# Skip X posts older than this many days.
#TWEET_MAX_AGE_DAYS=14

# --- Running ---
# `npm start` does one full run right away (articles, batch commits, LinkedIn, blog push, one reel)
# and exits. There is no scheduler: start it again for the next run.
# The only branch the blog sync commits to and pushes.
#BLOG_DEPLOY_BRANCH=main
# Used by the list tracker (npm run list) only.
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# --- Monitoring Configuration ---
CHECK_INTERVAL=30000
MONITOR_LIST_ID=1011591069782499328
SEND_ALL_TWEETS=true
MONITOR_KEYWORDS=

# --- Instagram content factory (docs/CONTENT_FACTORY.md) ---
# Off by default. When on, every pipeline cycle turns fresh articles into one-off reels/carousels.
FACTORY_ENABLED=false
# Opus runs through your LOCAL Claude Code (`claude -p`, your Claude sign-in) on the machine that runs
# `npm start`. No Anthropic API key. Install + sign in once: npm i -g @anthropic-ai/claude-code && claude
FACTORY_OPUS_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (xhigh = extra effort)
FACTORY_CLAUDE_EFFORT=xhigh
#CLAUDE_BIN=claude
# agent (default: every reel is a one-off film by the Claude Code agent) | hybrid | template
FACTORY_VIDEO_MODE=agent
# agent (default: every carousel designed slide by slide by the agent) | template (house slides)
FACTORY_CAROUSEL_MODE=agent
# hybrid mode only: agent reels per week (the rest use templates)
#FACTORY_HERO_PER_WEEK=2
# When a run brought nothing new: true = make a piece from the LinkedIn Insights archive,
# false (default) = skip, so the channel only posts fresh stories
FACTORY_ARCHIVE_FALLBACK=false
# remotion | hyperframes | auto (alternate)
FACTORY_HERO_ENGINE=remotion
# Slash skills the agent invokes when installed, comma-separated (plugin skills are /<plugin>:<skill>).
# Empty = the default below; "none" = no skills.
#FACTORY_HERO_SKILLS=/remotion:remotion-best-practices,/hyperframes:motion-graphics
#FACTORY_HERO_TIMEOUT_MS=3600000
# Per Opus call (storyboard, editor, references, QA); the director prompt gets at least 25 min
#FACTORY_OPUS_TIMEOUT_MS=600000
# How many recent pieces the novelty filter and look memory compare against
#FACTORY_NOVELTY_WINDOW=15
# Ledger, lock, voice cache and job dirs (default factory/state)
#FACTORY_STATE_DIR=
# true = ship a templated reel when an agent film fails (default false: retry next cycle, keep every reel unique)
FACTORY_TEMPLATE_FALLBACK=false
# Formats made from the story the editor picks (reel, carousel or both)
FACTORY_FORMATS=reel
# Stories per cycle: the editor picks the best of the run, researches its links, then makes it
FACTORY_PER_CYCLE=1
# Real material: screenshots of up to N pages the story links to (0 = none)
FACTORY_ASSET_PAGES=4

# Voiceover for agent reels (on | off). ElevenLabs is the main provider; without its key the
# OpenRouter speech model above is the fallback. The script uses ElevenLabs audio tags ([curious], [pause]...).
FACTORY_VOICE=on
ELEVENLABS_API_KEY=
# Your voice id (default: a premade narrator voice)
#ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_v4
#ELEVENLABS_FALLBACK_MODELS=eleven_v3,eleven_multilingual_v2
# 0 = most expressive, 0.5 = natural, 1 = most stable
#ELEVENLABS_STABILITY=0.5
#FACTORY_VOICE_FALLBACK_MODEL=openai/gpt-audio-mini
#FACTORY_VOICE_FALLBACK_VOICE=onyx
FACTORY_VISION_QA=true
FACTORY_HANDLE=@drix10
FACTORY_AUTHOR=Drishtant Ghosh
# Optional: Chromium for Remotion renders (empty = Remotion downloads its own headless shell)
#REMOTION_BROWSER=
# Optional API fallbacks for a server without Claude Code: anthropic | openrouter
#FACTORY_OPUS_BACKEND=claude-code
#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=https://api.anthropic.com
#FACTORY_OPENROUTER_OPUS_MODEL=anthropic/claude-opus-5.5

# Instagram (browser automation on the Chrome at :9222; log in to instagram.com there once)
# Nothing is shared unless IG_POST=true; otherwise the flow stops before "Share" and discards.
IG_POST=false
IG_DAILY_CAP=2
IG_MIN_GAP_MINUTES=180
